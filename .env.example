# Copiar a .env y completar localmente. Nunca compartir este archivo con secretos.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
# En la notebook servidor usar DJANGO_DEBUG=false.
DJANGO_DEBUG=true
# Servidor/acceso remoto (valores por defecto actuales; ver docs/servidor-notebook.md).
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://equipo.tailnet.ts.net
# DJANGO_HTTPS=false
# DJANGO_HSTS_SECONDS=0
# Backups (ver docs/servidor-notebook.md). Ruta de destino y archivo de clave FUERA de ese destino.
# TALLER_BACKUP_DIR=
# TALLER_BACKUP_KEY_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# IA de presupuestos: habilitar solo tras definir datos enviados, retención y límites.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false
