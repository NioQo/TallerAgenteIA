# Copiar a .env y completar localmente. Nunca compartir este archivo con secretos.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# IA de presupuestos: habilitar solo tras definir datos enviados, retención y límites.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false
